# Finales de línea y tipos de archivo, para que el historial no se ensucie.
#
# El proyecto se trabaja en Windows y se despliega en Linux (contenedor). Sin
# esto, un archivo generado en Windows entra al repositorio con CRLF y aparece
# como "modificado por completo" la siguiente vez que se regenera en otro
# sistema, aunque su contenido sea el mismo.

# Fuente del proyecto
*.py    text eol=lf
*.ipynb text eol=lf
*.yml   text eol=lf
*.md    text eol=lf
*.csv   text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.svg   text eol=lf
Dockerfile text eol=lf
