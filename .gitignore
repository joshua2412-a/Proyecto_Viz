# Entornos virtuales
venv/
.venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Build del Jupyter Book (se regenera con jupyter-book build jbook/)
jbook/_build/

# Artefacto intermedio que 01_EDA pasa a 02_Baseline
jbook/datos_modelado.pkl

# NOTA: model/model.pkl y model/metrics.json SÍ se versionan a propósito.
# App Engine tiene sistema de archivos de solo lectura y no podría entrenarlos
# al arrancar. Tampoco se ignora dataset/TCGA_InfoWithGrade.csv: es la única
# copia de los datos y el proyecto no funciona sin ella.

# Variables de entorno: nunca se versionan (claves, tokens, credenciales)
.env

# Imágenes Docker exportadas con `docker save` (pesan cientos de MB)
*.tar

# Editores y sistema operativo
.vscode/
.idea/
.DS_Store
Thumbs.db
